# Copia este archivo a .env.local y completa los valores reales.

# Región y User Pool de Cognito
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_USER_POOL_ID=us-east-2_KDduqjQdn

# App Client ID
VITE_COGNITO_CLIENT_ID=8vu37n7dpq595tfgsg8nrajc2

# Dominio del Hosted UI (Cognito > User pools > Domain)
# Formato: https://<prefijo>.auth.<region>.amazoncognito.com
VITE_COGNITO_DOMAIN=https://TU-PREFIJO.auth.us-east-2.amazoncognito.com

# Debe coincidir EXACTO con una "Callback URL" del App Client
VITE_REDIRECT_URI=http://localhost:5173/

# Debe coincidir EXACTO con una "Allowed sign-out URL" del App Client
VITE_LOGOUT_URI=http://localhost:5173/

# API de personajes (opcional).
# En desarrollo se usa el proxy de Vite /api-personajes.
# En producción, define aquí la URL completa si no usas el endpoint por defecto.
# VITE_API_PERSONAJES_URL=https://wznplg0ho7.execute-api.us-east-2.amazonaws.com/prod/api/personajes

# API de usuarios (opcional; por defecto usa el endpoint de API Gateway).
# VITE_API_USUARIOS_URL=https://wznplg0ho7.execute-api.us-east-2.amazonaws.com/prod/api-usuarios/usuarios
